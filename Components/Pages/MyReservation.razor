@page "/my-reservations"
@using LibraryInventory.Data
@using LibraryInventory.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ISnackbar Snackbar

<PageTitle>My Reservations</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">My Reservations</MudText>

@if (items is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudAlert Severity="@(totalFines > 0 ? Severity.Warning : Severity.Success)" Dense="true" Class="mb-4">
        @if (totalFines > 0)
        {
            <span>Fines owed: @totalFines.ToString("0.00")</span>
        }
        else
        {
            <span>You have no fines.</span>
        }
    </MudAlert>

    @if (!items.Any())
    {
        <MudText Class="mb-6">You have no reservations yet.</MudText>
    }
    else
    {
        <MudTable Items="items" Hover="true" Striped="true" Dense="true" Class="mb-6">
            <HeaderContent>
                <MudTh>Title</MudTh>
                <MudTh>Barcode</MudTh>
                <MudTh>Reserved</MudTh>
                <MudTh>Due</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Fine</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Title">
                    <MudLink Href="@($"/books/{context.BookId}")">@context.Title</MudLink>
                </MudTd>
                <MudTd DataLabel="Barcode">@context.Barcode</MudTd>
                <MudTd DataLabel="Reserved">@context.ReservedAt.ToLocalTime().ToString("d")</MudTd>
                <MudTd DataLabel="Due">@context.DueDate.ToLocalTime().ToString("d")</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context)">
                        @StatusText(context)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Fine">@context.FineAmount.ToString("0.00")</MudTd>
                <MudTd>
                    @if (context.Status == "Active")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                   OnClick="@(() => CancelAsync(context.Id))">
                            Cancel
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

<MudText Typo="Typo.h5" Class="mb-3">Waitlist</MudText>

@if (waiting is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!waiting.Any())
{
    <MudText>You are not waiting for any books.</MudText>
}
else
{
    <MudTable Items="waiting" Hover="true" Striped="true" Dense="true">
        <HeaderContent>
            <MudTh>Title</MudTh>
            <MudTh>Joined</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Title">
                <MudLink Href="@($"/books/{context.BookId}")">@context.Title</MudLink>
            </MudTd>
            <MudTd DataLabel="Joined">@context.JoinedAt.ToLocalTime().ToString("g")</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           OnClick="@(() => LeaveWaitlistAsync(context.Id))">
                    Leave
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<Row>? items;
    private List<WaitRow>? waiting;
    private decimal totalFines;

    private sealed class Row
    {
        public int Id { get; set; }
        public int BookId { get; set; }
        public string Title { get; set; } = "";
        public string Barcode { get; set; } = "";
        public DateTime ReservedAt { get; set; }
        public DateTime DueDate { get; set; }
        public string Status { get; set; } = "";
        public decimal FineAmount { get; set; }
    }

    private sealed class WaitRow
    {
        public int Id { get; set; }
        public int BookId { get; set; }
        public string Title { get; set; } = "";
        public DateTime JoinedAt { get; set; }
    }

    private static bool IsOverdue(Row row) =>
        row.Status == "Active" && row.DueDate < DateTime.UtcNow;

    private static string StatusText(Row row) =>
        IsOverdue(row) ? "Overdue" : row.Status;

    private static Color StatusColor(Row row)
    {
        if (IsOverdue(row)) return Color.Error;
        if (row.Status == "Active") return Color.Info;
        if (row.Status == "Completed") return Color.Success;
        return Color.Default;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user is null)
        {
            items = new();
            waiting = new();
            totalFines = 0;
            return;
        }

        items = await DbContext.Reservations
            .Where(r => r.UserId == user.Id)
            .OrderByDescending(r => r.ReservedAt)
            .Select(r => new Row
            {
                Id = r.Id,
                BookId = r.BookCopy!.BookId,
                Title = r.BookCopy.Book!.Title,
                Barcode = r.BookCopy.Barcode,
                ReservedAt = r.ReservedAt,
                DueDate = r.DueDate,
                Status = r.Status,
                FineAmount = r.FineAmount
            })
            .ToListAsync();

        totalFines = items.Sum(r => r.FineAmount);

        waiting = await DbContext.WaitlistEntries
            .Where(w => w.UserId == user.Id && w.Status == "Waiting")
            .OrderBy(w => w.JoinedAt)
            .Select(w => new WaitRow
            {
                Id = w.Id,
                BookId = w.BookId,
                Title = w.Book!.Title,
                JoinedAt = w.JoinedAt
            })
            .ToListAsync();
    }

    private async Task CancelAsync(int id)
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user is null) return;

        var reservation = await DbContext.Reservations
            .Include(r => r.BookCopy)
            .FirstOrDefaultAsync(r => r.Id == id && r.UserId == user.Id && r.Status == "Active");

        if (reservation?.BookCopy is null)
        {
            Snackbar.Add("Reservation not found.", Severity.Warning);
            return;
        }

        reservation.Status = "Cancelled";
        reservation.BookCopy.Status = "Available";
        reservation.BookCopy.UpdatedAt = DateTime.UtcNow;
        await DbContext.SaveChangesAsync();

        Snackbar.Add("Reservation cancelled.", Severity.Success);
        await LoadAsync();
    }

    private async Task LeaveWaitlistAsync(int id)
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user is null) return;

        var entry = await DbContext.WaitlistEntries
            .FirstOrDefaultAsync(w => w.Id == id && w.UserId == user.Id && w.Status == "Waiting");

        if (entry is null)
        {
            Snackbar.Add("Waitlist entry not found.", Severity.Warning);
            return;
        }

        entry.Status = "Cancelled";
        await DbContext.SaveChangesAsync();
        Snackbar.Add("Left the waitlist.", Severity.Success);
        await LoadAsync();
    }
}