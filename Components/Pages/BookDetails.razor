@page "/books/{Id:int}"
@using LibraryInventory.Data
@using LibraryInventory.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ISnackbar Snackbar

<PageTitle>@(book?.Title ?? "Book Details")</PageTitle>

@if (book is null)
{
    <MudProgressCircular Indeterminate="true" Class="mt-8" />
}
else
{
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/books" Class="mb-4">
        Back to Books
    </MudButton>

    <MudPaper Class="pa-6 mb-6" Elevation="2">
        <MudText Typo="Typo.h4" Class="mb-2">@book.Title</MudText>
        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-4">@book.Author</MudText>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudText><strong>ISBN:</strong> @book.ISBN</MudText>
                <MudText><strong>Category:</strong> @book.Category?.Name</MudText>
                <MudText><strong>Year:</strong> @book.PublicationYear</MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Class="mb-3"><strong>Available copies:</strong>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(availableCount > 0 ? Color.Success : Color.Error)">
                        @availableCount / @book.Copies.Count
                    </MudChip>
                </MudText>

                @if (isAuthenticated && alreadyReserved)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        You already have an active reservation for this book.
                    </MudAlert>
                }
                else if (isAuthenticated && atLimit)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        You already have @MaxActive active reservations. Cancel one before reserving another book.
                    </MudAlert>
                }
                else if (isAuthenticated && availableCount > 0)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="reserving" OnClick="ReserveAsync">
                        @(reserving ? "Reserving..." : "Reserve for 14 days")
                    </MudButton>
                }
                else if (!isAuthenticated)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               Href="Identity/Account/Login">
                        Log in to reserve
                    </MudButton>
                }
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrWhiteSpace(book.Description))
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.body1">@book.Description</MudText>
        }
    </MudPaper>

    <MudText Typo="Typo.h5" Class="mb-3">Copies</MudText>

    <MudTable Items="book.Copies" Hover="true" Striped="true" Dense="true">
        <HeaderContent>
            <MudTh>Barcode</MudTh>
            <MudTh>Location</MudTh>
            <MudTh>Condition</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Barcode">@context.Barcode</MudTd>
            <MudTd DataLabel="Location">@context.Location</MudTd>
            <MudTd DataLabel="Condition">@context.Condition</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                    @context.Status
                </MudChip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private const int MaxActive = 3;

    [Parameter]
    public int Id { get; set; }

    private Book? book;
    private int availableCount;
    private bool isAuthenticated;
    private bool alreadyReserved;
    private bool atLimit;
    private bool reserving;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = auth.User.Identity?.IsAuthenticated == true;
        await LoadBookAsync();
    }

    private async Task LoadBookAsync()
    {
        book = await DbContext.Books
            .Include(b => b.Category)
            .Include(b => b.Copies)
            .FirstOrDefaultAsync(b => b.Id == Id && !b.IsDeleted);

        if (book is null)
        {
            Navigation.NavigateTo("/books");
            return;
        }

        availableCount = book.Copies.Count(c => c.Status == "Available");
        alreadyReserved = false;
        atLimit = false;

        if (!isAuthenticated)
            return;

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user is null)
            return;

        alreadyReserved = await DbContext.Reservations.AnyAsync(r =>
            r.UserId == user.Id &&
            r.Status == "Active" &&
            r.BookCopy!.BookId == Id);

        var activeCount = await DbContext.Reservations.CountAsync(r =>
            r.UserId == user.Id && r.Status == "Active");
        atLimit = activeCount >= MaxActive;
    }

    private async Task ReserveAsync()
    {
        reserving = true;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(auth.User);
            if (user is null)
            {
                Snackbar.Add("Please log in first.", Severity.Warning);
                return;
            }

            var hasActive = await DbContext.Reservations.AnyAsync(r =>
                r.UserId == user.Id &&
                r.Status == "Active" &&
                r.BookCopy!.BookId == Id);

            if (hasActive)
            {
                Snackbar.Add("You already have this book reserved.", Severity.Warning);
                await LoadBookAsync();
                return;
            }

            var activeCount = await DbContext.Reservations.CountAsync(r =>
                r.UserId == user.Id && r.Status == "Active");
            if (activeCount >= MaxActive)
            {
                Snackbar.Add($"Limit is {MaxActive} active reservations.", Severity.Warning);
                await LoadBookAsync();
                return;
            }

            var copy = await DbContext.BookCopies
                .FirstOrDefaultAsync(c => c.BookId == Id && c.Status == "Available");

            if (copy is null)
            {
                Snackbar.Add("No copies are available.", Severity.Warning);
                await LoadBookAsync();
                return;
            }

            copy.Status = "Reserved";
            copy.UpdatedAt = DateTime.UtcNow;

            DbContext.Reservations.Add(new Reservation
            {
                UserId = user.Id,
                BookCopyId = copy.Id,
                ReservedAt = DateTime.UtcNow,
                DueDate = DateTime.UtcNow.AddDays(14),
                Status = "Active"
            });

            await DbContext.SaveChangesAsync();
            Snackbar.Add($"Reserved. Due {DateTime.UtcNow.AddDays(14):d}.", Severity.Success);
            await LoadBookAsync();
        }
        finally
        {
            reserving = false;
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Available" => Color.Success,
        "CheckedOut" => Color.Warning,
        "Reserved" => Color.Info,
        "Lost" or "Damaged" => Color.Error,
        _ => Color.Default
    };
}