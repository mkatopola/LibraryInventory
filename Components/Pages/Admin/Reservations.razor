@page "/admin/reservations"
@using LibraryInventory.Data
@using LibraryInventory.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Admin")]
@inject ApplicationDbContext DbContext
@inject ISnackbar Snackbar

<PageTitle>All Reservations</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Active Reservations</MudText>

@if (items is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!items.Any())
{
    <MudText Class="mb-6">No active reservations.</MudText>
}
else
{
    <MudTable Items="items" Hover="true" Striped="true" Dense="true" Class="mb-6">
        <HeaderContent>
            <MudTh>User</MudTh>
            <MudTh>Title</MudTh>
            <MudTh>Barcode</MudTh>
            <MudTh>Due</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="User">@context.Email</MudTd>
            <MudTd DataLabel="Title">@context.Title</MudTd>
            <MudTd DataLabel="Barcode">@context.Barcode</MudTd>
            <MudTd DataLabel="Due">@context.DueDate.ToLocalTime().ToString("d")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsOverdue ? Color.Error : Color.Info)">
                    @(context.IsOverdue ? "Overdue" : "Active")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                           OnClick="@(() => MarkReturnedAsync(context.Id))">
                    Mark returned
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<MudText Typo="Typo.h5" Class="mb-3">Completed</MudText>

@if (completed is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!completed.Any())
{
    <MudText>No completed loans yet.</MudText>
}
else
{
    <MudTable Items="completed" Hover="true" Striped="true" Dense="true">
        <HeaderContent>
            <MudTh>User</MudTh>
            <MudTh>Title</MudTh>
            <MudTh>Returned</MudTh>
            <MudTh>Fine</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="User">@context.Email</MudTd>
            <MudTd DataLabel="Title">@context.Title</MudTd>
            <MudTd DataLabel="Returned">@context.ReturnedAt?.ToLocalTime().ToString("g")</MudTd>
            <MudTd DataLabel="Fine">@context.FineAmount.ToString("0.00")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private const int MaxActive = 3;
    private const decimal FinePerDay = 5m;

    private List<Row>? items;
    private List<CompletedRow>? completed;

    private sealed class Row
    {
        public int Id { get; set; }
        public string Email { get; set; } = "";
        public string Title { get; set; } = "";
        public string Barcode { get; set; } = "";
        public DateTime DueDate { get; set; }
        public bool IsOverdue { get; set; }
    }

    private sealed class CompletedRow
    {
        public string Email { get; set; } = "";
        public string Title { get; set; } = "";
        public DateTime? ReturnedAt { get; set; }
        public decimal FineAmount { get; set; }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var now = DateTime.UtcNow;
        items = await DbContext.Reservations
            .Where(r => r.Status == "Active")
            .OrderBy(r => r.DueDate)
            .Select(r => new Row
            {
                Id = r.Id,
                Email = r.User!.Email ?? r.UserId,
                Title = r.BookCopy!.Book!.Title,
                Barcode = r.BookCopy.Barcode,
                DueDate = r.DueDate,
                IsOverdue = r.DueDate < now
            })
            .ToListAsync();

        completed = await DbContext.Reservations
            .Where(r => r.Status == "Completed")
            .OrderByDescending(r => r.ReturnedAt)
            .Take(20)
            .Select(r => new CompletedRow
            {
                Email = r.User!.Email ?? r.UserId,
                Title = r.BookCopy!.Book!.Title,
                ReturnedAt = r.ReturnedAt,
                FineAmount = r.FineAmount
            })
            .ToListAsync();
    }

    private async Task MarkReturnedAsync(int id)
    {
        var reservation = await DbContext.Reservations
            .Include(r => r.BookCopy)
            .FirstOrDefaultAsync(r => r.Id == id && r.Status == "Active");

        if (reservation?.BookCopy is null)
        {
            Snackbar.Add("Reservation not found.", Severity.Warning);
            return;
        }

        var now = DateTime.UtcNow;
        var daysLate = (now.Date - reservation.DueDate.Date).Days;
        if (daysLate < 0)
            daysLate = 0;

        reservation.Status = "Completed";
        reservation.ReturnedAt = now;
        reservation.FineAmount = daysLate * FinePerDay;

        var bookId = reservation.BookCopy.BookId;
        var waiting = await DbContext.WaitlistEntries
            .Where(w => w.BookId == bookId && w.Status == "Waiting")
            .OrderBy(w => w.JoinedAt)
            .ToListAsync();

        WaitlistEntry? chosen = null;
        foreach (var entry in waiting)
        {
            var activeCount = await DbContext.Reservations.CountAsync(r =>
                r.UserId == entry.UserId && r.Status == "Active");
            if (activeCount < MaxActive)
            {
                chosen = entry;
                break;
            }
        }

        if (chosen is null)
        {
            reservation.BookCopy.Status = "Available";
        }
        else
        {
            chosen.Status = "Fulfilled";
            reservation.BookCopy.Status = "Reserved";
            DbContext.Reservations.Add(new Reservation
            {
                UserId = chosen.UserId,
                BookCopyId = reservation.BookCopy.Id,
                ReservedAt = now,
                DueDate = now.AddDays(14),
                Status = "Active"
            });
        }

        reservation.BookCopy.UpdatedAt = now;
        await DbContext.SaveChangesAsync();

        var message = reservation.FineAmount == 0
            ? "Marked as returned. No fine."
            : $"Marked as returned. Fine: {reservation.FineAmount:0.00} ({daysLate} day(s) late).";
        if (chosen is not null)
            message += " Copy given to the next person on the waitlist.";

        Snackbar.Add(message, reservation.FineAmount == 0 ? Severity.Success : Severity.Warning);
        await LoadAsync();
    }
}