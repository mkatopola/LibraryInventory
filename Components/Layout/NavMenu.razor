@using Microsoft.AspNetCore.Components.Authorization

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        Home
    </MudNavLink>
    <MudNavLink Href="/books" Icon="@Icons.Material.Filled.MenuBook">
        Books
    </MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="/my-reservations" Icon="@Icons.Material.Filled.Assignment">
                My Reservations
            </MudNavLink>

            <AuthorizeView Roles="Admin" Context="admin">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.caption" Class="px-4">Admin</MudText>
                <MudNavLink Href="/admin/books" Icon="@Icons.Material.Filled.LibraryBooks">
                    Manage Books
                </MudNavLink>
                <MudNavLink Href="/admin/reservations" Icon="@Icons.Material.Filled.FactCheck">
                    Reservations
                </MudNavLink>
            </AuthorizeView>

            <MudDivider Class="my-2" />
            <form method="post" action="Identity/Account/Logout">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="/" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Logout" FullWidth="true" Class="justify-start">
                    Logout
                </MudButton>
            </form>
        </Authorized>
        <NotAuthorized>
            <MudDivider Class="my-2" />
            <MudNavLink Href="Identity/Account/Login" Icon="@Icons.Material.Filled.Login">
                Login
            </MudNavLink>
            <MudNavLink Href="Identity/Account/Register" Icon="@Icons.Material.Filled.PersonAdd">
                Register
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>